@prefix samm: <urn:samm:org.eclipse.esmf.samm:meta-model:2.2.0#> .
@prefix samm-c: <urn:samm:org.eclipse.esmf.samm:characteristic:2.2.0#> .
@prefix samm-e: <urn:samm:org.eclipse.esmf.samm:entity:2.2.0#> .
@prefix unit: <urn:samm:org.eclipse.esmf.samm:unit:2.2.0#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <urn:samm:org.eclipse.esmf.examples.machine_online_status:1.0.0#> .

# In version 1.0.0 of the model, the modeler decides to first represent the
# Property itself using an OnlineStatus Characteristic . They use the string
# datatype to be able to represent the four valid states given in the target
# machine’s data sheet.

:MachineOnlineStatus a samm:Aspect ;
   samm:properties ( :machineOnlineStatus ) ;
   samm:operations ( ) .

:machineOnlineStatus a samm:Property ;
   samm:description "The current machine online status. Can be either ON, OFF, BOOTING or UNDEFINED."@en ;
   samm:characteristic [
      a samm:Characteristic ;
      samm:dataType xsd:string
   ] .
